// Prisma-Schema — Zero-Knowledge: der Server hält NUR Chiffrat + Referenzen.
// Es gibt bewusst KEINE Tabelle für Recovery-Codes oder Klartext-Schlüssel: die
// Wiederherstellung passiert client-seitig (der sealBackup-Blob enthält beide gewrappten
// DEKs). Der Server kann nichts entschlüsseln — das ist die ganze Garantie.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id          String               @id @default(uuid())
  createdAt   DateTime             @default(now())
  // Zufälliges WebAuthn-User-Handle (kein PII). Discoverable Credentials.
  handle      Bytes                @unique
  credentials WebAuthnCredential[]
  backup      EncryptedBackup?
  sessions    Session[]
  auditLogs   AuditLog[]
}

model WebAuthnCredential {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId Bytes    @unique
  publicKey    Bytes
  counter      BigInt   @default(0) // Signatur-Zähler: erkennt geklonte Authenticators
  transports   String?
  createdAt    DateTime @default(now())

  @@index([userId])
}

model EncryptedBackup {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Ausgabe von vault.sealBackup(): iv, ct, salts, wrappedPrf, wrappedRecovery.
  // Ausschliesslich Chiffrat — für den Server bedeutungslos.
  blob      Json
  version   Int
  updatedAt DateTime @updatedAt
}

model Session {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Nur der SHA-256-Hash des opaken Session-Tokens — nie das Token selbst.
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime? // serverseitiger Logout / "überall abmelden"

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  event     String // z. B. "login_ok", "login_fail", "backup_put" — nie PII/Token
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId])
}
