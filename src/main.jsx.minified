import React, { useState, useEffect } from 'react';
import ReactDOM from 'react-dom/client';
import { DARK_PALETTE, LIGHT_PALETTE, CHAPTERS } from './config/constants.js';
import ThemeToggle from './ThemeToggle.jsx';
import Dashboard from './Dashboard.jsx';
import ChapterView from './ChapterView.jsx';
import DocumentTresor from './DocumentTresor.jsx';
import KKScanner from './KKScanner.jsx';
import BudgetImport from './BudgetImport.jsx';
  const [isDarkMode, setIsDarkMode] = useState(() => { try { return JSON.parse(localStorage.getItem("or5_theme") || "true"); } catch { return true; } });
import SchuldenManager from './SchuldenManager.jsx';
import TaxCalculator from './TaxCalculator.jsx';
import OrganDonation from './OrganDonation.jsx';
import BudgetSync from './BudgetSync.jsx';
import PremiumSubsidy from './PremiumSubsidy.jsx';
import EmergencyHub from './EmergencyHub.jsx';
import CVGenerator from './CVGenerator.jsx';
import ChartsAdvanced from './ChartsAdvanced.jsx';
import ZipExport from './ZipExport.jsx';
import MobileNav from './MobileNav.jsx';
import AutoSaveStatus from './AutoSaveStatus.jsx';

const App = () => {
  const [isDarkMode, setIsDarkMode] = useState(() => { try { return JSON.parse(localStorage.getItem('or5_theme') || 'true'); } catch { return true; } });
  const palette = isDarkMode ? DARK_PALETTE : LIGHT_PALETTE;
  const [data, setData] = useState(() => { try { return JSON.parse(localStorage.getItem('or5_data') || '{}'); } catch { return {}; } });
  const [view, setView] = useState('dashboard');
  const [activeChapter, setActiveChapter] = useState(0);
  const [mobileNavOpen, setMobileNavOpen] = useState(false);
  const [lastSave, setLastSave] = useState(null);
  const [isSaving, setIsSaving] = useState(false);

  useEffect(() => { localStorage.setItem('or5_theme', JSON.stringify(isDarkMode)); }, [isDarkMode]);
  useEffect(() => { const timer = setInterval(() => { setIsSaving(true); localStorage.setItem('or5_data', JSON.stringify(data)); setLastSave(new Date()); setIsSaving(false); }, 5000); return () => clearInterval(timer); }, [data]);

  const updateData = (chapter, field, value) => { setData(prev => ({ ...prev, [chapter]: { ...prev[chapter], [field]: value } })); };
  const calculateCompletion = () => { let filled = 0, total = 0; CHAPTERS.forEach(ch => { ch.fields.forEach(f => { total++; if (data[ch.key]?.[f.k]) filled++; }); }); return total > 0 ? Math.round((filled / total) * 100) : 0; };

  return React.createElement('div', { style: { width: '100vw', height: '100vh', background: palette.bg, color: palette.text, fontFamily: 'DM Sans, sans-serif', display: 'flex', flexDirection: 'column' } },
    React.createElement('div', { style: { background: palette.surface, borderBottom: '1px solid ' + palette.border, padding: '16px 20px', display: 'flex', justifyContent: 'space-between', alignItems: 'center', gap: '12px' } },
      React.createElement('h1', { style: { fontSize: '18px', fontWeight: '600', margin: 0 } }, '◎ Ordnung & Ruhe'),
      React.createElement('div', { style: { display: 'flex', gap: '8px', alignItems: 'center' } },
        React.createElement('span', { style: { fontSize: '12px', color: palette.mid } }, calculateCompletion() + '%'),
        React.createElement(ThemeToggle, { palette, isDarkMode, onToggle: () => setIsDarkMode(!isDarkMode) }),
        React.createElement('button', { onClick: () => setMobileNavOpen(!mobileNavOpen), style: { padding: '8px 12px', background: palette.up, color: palette.text, border: '1px solid ' + palette.border, borderRadius: '6px', cursor: 'pointer', fontSize: '12px', fontWeight: '600' } }, '☰')
      )
    ),
    React.createElement('div', { style: { flex: 1, overflowY: 'auto', padding: '20px' } },
      view === 'dashboard' && React.createElement(Dashboard, { palette, chapters: CHAPTERS, data, onSelectChapter: (idx) => { setActiveChapter(idx); setView('chapter'); }, completion: calculateCompletion(), onNavigate: setView }),
      view === 'chapter' && React.createElement(ChapterView, { palette, chapter: CHAPTERS[activeChapter], data: data[CHAPTERS[activeChapter].key] || {}, onUpdate: (field, value) => updateData(CHAPTERS[activeChapter].key, field, value) }),
      view === 'tresor' && React.createElement(DocumentTresor, { palette }),
      view === 'kk' && React.createElement(KKScanner, { palette }),
      view === 'budget' && React.createElement(BudgetImport, { palette }),
      view === 'schulden' && React.createElement(SchuldenManager, { palette }),
      view === 'tax' && React.createElement(TaxCalculator, { palette }),
      view === 'organ' && React.createElement(OrganDonation, { palette }),
      view === 'sync' && React.createElement(BudgetSync, { palette, data }),
      view === 'premium' && React.createElement(PremiumSubsidy, { palette, data }),
      view === 'notfall' && React.createElement(EmergencyHub, { palette, data }),
      view === 'cv' && React.createElement(CVGenerator, { palette, data }),
      view === 'charts' && React.createElement(ChartsAdvanced, { palette }),
      view === 'export' && React.createElement(ZipExport, { palette, data })
    ),
    React.createElement(AutoSaveStatus, { palette, lastSave, isSaving })
  );
};

ReactDOM.createRoot(document.getElementById('root')).render(React.createElement(App));
export default App;
