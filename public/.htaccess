# Maloja Plana — Apache Security Headers
# ⚠️ WIRD NICHT DEPLOYT: deploy.sh löscht dist/.htaccess und lädt die Wurzel ohne
# --delete hoch — die .htaccess AUF DEM SERVER bleibt dadurch unberührt. Die Live-Header
# kommen aus dieser Server-Datei (von Stebler Studios von Hand gepflegt; Stand 17.09.2026:
# geolocation=(self), gemessen per curl). Diese Datei hier ist nur die Vorlage.
# CSP is already defined via <meta> in index.html — not duplicated here.

<IfModule mod_headers.c>
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
</IfModule>

# Custom 404 page
ErrorDocument 404 /404.html
